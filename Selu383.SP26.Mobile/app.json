{
  "expo": {
    "name": "Selu383-SP26-P03-Mobile-g03",
    "slug": "Selu383-SP26-P03-Mobile-g03",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ConceptLogo2.png",
    "scheme": "selu383sp26mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3A2E1F",
        "foregroundImage": "./assets/images/ConceptLogo2.png",
        "monochromeImage": "./assets/images/ConceptLogo2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.selu383.sp26.p03.g03"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ConceptLogo2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ConceptLogo2.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#3A2E1F",
          "dark": {
            "backgroundColor": "#1A1410"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "reactNativeArchitectures": "arm64-v8a,x86_64"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9922b588-2a19-4259-85da-fc4febb6fe5f"
      }
    },
    "owner": "phase3"
  }
}
